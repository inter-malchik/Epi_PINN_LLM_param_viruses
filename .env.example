# Copy this file to .env and set your own values.

MODEL_NAME_HF=meta-llama/Llama-3.3-70B-Instruct
MODEL_TEMPERATURE_HF=0.0
MAX_TOKENS=1024
# HUGGINGFACE_HUB_TOKEN=your_token_here
HF_USE_API=True
# Use cuda for a GPU
HF_DEVICE=cpu

# LLM provider: huggingface, openai, vllm, lmstudio
LLM_PROVIDER=huggingface

LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=local-model
LMSTUDIO_TEMPERATURE=0.0
LMSTUDIO_MAX_TOKENS=1024
